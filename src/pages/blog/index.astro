---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../../lib/formatDate";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Blog Posts">
  <div
    class="container mx-auto flex flex-col justify-center items-center max-w-screen-xl"
  >
    <h1 class="font-bold text-5xl">Blog Posts</h1>

    <section class="mt-15">
      {
        posts.map((post) => (
          <article class="my-10 max-w-prose">
            <h2 class="font-bold text-3xl mb-1">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="text-base leading-6 display mb-3">
              <time>{formatDate(post.data.date)}</time>
            </p>
            {post.data.description && (
              <p class="text-lg mb-3">{post.data.description}</p>
            )}
            <p>
              <a
                href={`/blog/${post.id}/`}
                class="font-medium text-lg"
              >
                Read more →
              </a>
            </p>
          </article>
        ))
      }
    </section>
  </div>
</BaseLayout>
