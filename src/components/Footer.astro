---
import { socials } from "../data/socials";
---

<footer class="bottom-0 text-left w-full p-4 bg-gray-900">
  <div class="container mx-auto flex flex-row justify-between">
    <div class="flex flex-row">
      <ul class="p-0 font-medium relative">
        {
          socials.links.map((link) => (
            <li>
              <a
                class="text-gray-300 relative my-2 inline-block hover:text-white hover:translate-x-1 transition-transform transform"
                href={link.url}
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
