---
import SignatureLogo from "./SignatureLogo.astro";
import { navigation } from "../data/navigation";
import { socials } from "../data/socials";

const footerLinks = [
  ...navigation.items,
  { text: "About", url: "/about" },
  { text: "Blog", url: "/blog" },
];
---

<footer class="bg-ink text-cream py-16 md:py-24">
  <div class="container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="inline-block text-cream no-underline hover:text-cream/70 transition-colors">
          <SignatureLogo class="text-4xl md:text-5xl" />
        </a>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-cream/50 mb-4">Explore</p>
        <ul class="space-y-2 list-none m-0 p-0">
          {
            footerLinks.map((item) => (
              <li>
                <a
                  href={item.url}
                  class="text-sm text-cream/80 hover:text-cream no-underline transition-colors"
                >
                  {item.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-cream/50 mb-4">Connect</p>
        <ul class="space-y-2 list-none m-0 p-0">
          <li>
            <a
              href="#work-with-me"
              class="text-sm text-cream/80 hover:text-cream no-underline transition-colors"
            >
              Get in touch
            </a>
          </li>
          {
            socials.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  class="text-sm text-cream/80 hover:text-cream no-underline transition-colors"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-cream/50 mb-4">Speaking</p>
        <p class="text-sm text-cream/80 leading-relaxed">
          Available for speaking engagements.
          <a href="#work-with-me" class="text-cream underline hover:text-cream/70">
            Enquire here
          </a>
        </p>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 pt-8 mt-12 border-t border-cream/10">
      <p class="text-xs text-cream/50 m-0">
        &copy; {new Date().getFullYear()} John Greenow
      </p>

      <a
        href="https://www.eitrainingcompany.com/eq-i/"
        class="opacity-60 hover:opacity-100 transition-opacity self-start sm:self-auto"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="/img/eqi.png"
          alt="EQ-i qualified coach"
          class="h-8 object-contain brightness-0 invert"
        />
      </a>
    </div>
  </div>
</footer>
