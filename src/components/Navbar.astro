---
import { navigation } from "../data/navigation";

interface Props {
  path?: string;
}

const { path } = Astro.props;
const deferOnDesktop = path === "home";
---

<header
  id="site-navbar"
  class:list={[
    "site-navbar sticky top-0 z-50 w-full bg-cream/95 backdrop-blur border-b border-border transition-[opacity,background-color,border-color] duration-500 ease-out",
    { "is-visible": !deferOnDesktop },
  ]}
  data-nav-defer={deferOnDesktop ? "true" : undefined}
>
  <nav class="container flex items-center justify-between py-3 sm:py-4">
    <a href="/" class="text-lg sm:text-xl md:text-2xl text-ink no-underline hover:text-ink-muted transition-colors">
      John Greenow
    </a>

    {
      navigation.items.length > 0 && (
        <ul class="flex items-center gap-1 md:gap-4 list-none m-0 p-0">
          {navigation.items.map((item) => (
            <li>
              <a
                class="text-ink-muted hover:text-ink text-sm md:text-base no-underline px-2 md:px-3 py-2 transition-colors"
                href={item.url}
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </nav>
</header>

{
  deferOnDesktop && (
    <script>
      function setupDeferredNavbar() {
        const navbar = document.getElementById("site-navbar");
        const hero = document.getElementById("hero");
        if (!navbar || navbar.dataset.navDefer !== "true" || !hero) return;

        const lgQuery = window.matchMedia("(min-width: 1024px)");
        let observer: IntersectionObserver | null = null;

        function setVisible(visible: boolean) {
          navbar!.classList.toggle("is-visible", visible);
        }

        function teardownObserver() {
          if (observer) {
            observer.disconnect();
            observer = null;
          }
        }

        function enable() {
          if (!lgQuery.matches) {
            teardownObserver();
            setVisible(true);
            return;
          }

          setVisible(false);

          if (!observer) {
            observer = new IntersectionObserver(
              (entries) => {
                setVisible(!entries[0]?.isIntersecting);
              },
              { threshold: 0 }
            );
            observer.observe(hero);
          }
        }

        enable();
        lgQuery.addEventListener("change", enable);
      }

      setupDeferredNavbar();
      document.addEventListener("astro:page-load", setupDeferredNavbar);
    </script>
  )
}
