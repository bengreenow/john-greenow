---
import type { Quote } from "../data/quotes";

interface Props {
  items: Quote[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="py-10 sm:py-16 md:py-20" data-fade>
      <div class="container">
        <h2 class="section-heading text-2xl sm:text-3xl md:text-4xl mb-8 sm:mb-10">What leaders say</h2>

        <ul class="max-w-3xl flex flex-col gap-8 sm:gap-12">
          {items.map((testimonial) => (
            <li class="flex gap-4 sm:gap-6">
              {testimonial.image && (
                <img
                  src={testimonial.image}
                  alt={testimonial.name}
                  width="80"
                  height="80"
                  class="w-16 h-16 sm:w-20 sm:h-20 flex-shrink-0 rounded-full object-cover object-top"
                  loading="lazy"
                />
              )}
              <figure>
                <blockquote class="text-base sm:text-lg text-ink leading-relaxed">
                  &ldquo;{testimonial.quote}&rdquo;
                </blockquote>
                <figcaption class="mt-4">
                  <p class="text-ink">{testimonial.name}</p>
                  <p class="text-sm text-ink-muted mt-1">
                    {testimonial.position}
                  </p>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
