---
import type { Quote } from "../data/quotes";

interface Props {
  items: Quote[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="w-full bg-gray-900 flex p-4 overflow-hidden relative">
      <div class="glide">
        <div class="glide__track" data-glide-el="track">
          <ul class="glide__slides flex items-center">
            {items.map((testimonial) => (
              <li class="glide__slide p-5 md:m-3">
                <p class="max-w-prose">{testimonial.quote}</p>
                <p class="font-display text-left font-bold text-gray-200 mt-2">
                  {testimonial.name}
                </p>
                <p class="font-display text-left italic text-gray-400 text-sm max-w-xs">
                  {testimonial.position}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  )
}

<script>
  import Glide from "@glidejs/glide";
  import "@glidejs/glide/dist/css/glide.core.min.css";

  new Glide(".glide", {
    gap: 100,
    type: "carousel",
    perView: 2,
    focusAt: "center",
    autoplay: 5000,
    animationDuration: 1000,
    throttle: true,
    breakpoints: { 600: { perView: 1 }, 1200: { perView: 2 } },
  }).mount();
</script>
