<div class="container p-4 flex max-w-screen-xl justify-center">
  <div class="flex mx-2 max-w-lg flex-col">
    <h1 class="text-5xl block font-bold display pb-3" id="contact">
      Get in touch
    </h1>
    <p>How can I help you in your world?</p>
    <p class="text-gray-400 text-sm mb-1">
      Whether that's as a coach, a speaker or a voice of experience, get in
      touch and I will do my best to serve you.
    </p>
    <form
      id="contact-form"
      class="w-full m-auto"
      method="POST"
      name="contact"
      data-netlify="true"
    >
      <input type="hidden" name="form-name" value="contact" />
      <div class="flex flex-wrap mx-auto">
        <div class="w-full md:w-1/2 p-2">
          <label for="first-name" class="mb-1 block font-bold">Name</label>
          <input
            type="text"
            class="p-2 bg-gray-800 w-full"
            name="name"
            id="first-name"
          />
        </div>
        <div class="w-full md:w-1/2 p-2">
          <label for="email" class="mb-1 block font-bold">Email</label>
          <input
            type="email"
            class="p-2 bg-gray-800 w-full"
            name="email"
            id="email"
          />
        </div>
        <div class="w-full p-2">
          <label for="comment" class="mb-1 block font-bold">Comment</label>
          <textarea
            class="p-2 bg-gray-800 w-full focus:border-transparent"
            name="comment"
            id="comment"
          ></textarea>
        </div>
        <div class="w-full md:w-1/2 p-2">
          <input
            type="submit"
            class="p-3 bg-gray-800 text-white hover:bg-purple-500 transition-colors cursor-pointer"
            value="Submit"
          />
        </div>
      </div>
    </form>
  </div>
</div>
