---
import { newsletter } from "../data/newsletter";

const actionUrl = `https://buttondown.com/api/emails/embed-subscribe/${newsletter.username}`;
---

<section id="hero" class="container pt-5 pb-8 sm:pt-7 sm:pb-12 md:pt-10 md:pb-16 lg:pt-12 lg:pb-8">
  <div class="max-w-6xl mx-auto">
    <header
      class="flex w-full flex-col lg:flex-row items-start gap-6 sm:gap-8 lg:gap-12 mx-auto lg:w-max text-left"
    >
      <div
        class="w-full max-w-[11rem] sm:max-w-xs lg:w-[19rem] lg:max-w-none flex-shrink-0 opacity-0 transition duration-1000"
        data-replace="{ 'opacity-0': 'opacity-100' }"
      >
        <img
          src="/img/john2.jpg"
          alt="John Greenow"
          class="w-full aspect-[3/4] sm:aspect-[9/16] lg:aspect-auto lg:h-[32rem] object-cover object-top"
        />
      </div>

      <div
        class="w-full min-w-0 lg:max-w-md opacity-0 transition duration-1000 delay-300"
        data-replace="{ 'opacity-0': 'opacity-100' }"
      >
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl text-ink leading-tight mb-3 sm:mb-4 lg:mb-6">
          John Greenow <span class="text-[0.6em]">M.A.</span>
        </h1>
        <p class="text-lg sm:text-xl md:text-2xl lg:text-xl text-ink leading-snug mb-4 sm:mb-6 lg:mb-8">
          Personal coach for pastors and ministry leaders
        </p>
        <p class="text-base sm:text-lg md:text-xl lg:text-lg text-ink-muted leading-relaxed">
            I've been in ministry for over 30 years, including many seasons of hard change, and I've learnt a lot of valuable lessons.
            I want to help you learn from my experiences and avoid the mistakes I made.
        </p>

        <div id="newsletter" class="mt-6 sm:mt-8 lg:mt-6 w-full sm:max-w-md">
          <p class="text-ink mb-1">Monthly letters for pastors and leaders</p>
          <p class="text-sm text-ink-muted mb-3 sm:mb-4">
            Encouragement and honest insight, once a month.
          </p>
          <form
            action={actionUrl}
            method="post"
            class="flex flex-col gap-3 sm:flex-row"
          >
            <input
              type="email"
              name="email"
              id="bd-email"
              placeholder="your@email.com"
              required
              class="form-input flex-1 min-w-0"
            />
            <input
              type="submit"
              value="Subscribe"
              id="newsletter-subscribe"
              class="btn-primary w-full sm:w-auto sm:flex-shrink-0"
            />
          </form>
          <p class="text-xs text-ink-muted mt-3">
            No spam. Unsubscribe any time.
          </p>
        </div>
      </div>
    </header>
  </div>
</section>
